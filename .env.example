NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5274
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@localhost:5432/healthcopilot
SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google
GEMINI_API_KEY=
# Optional separate keys; if blank the app uses GEMINI_API_KEY for both roles.
GEMINI_MEDICAL_API_KEY=
GEMINI_VOICE_API_KEY=
GEMINI_MEDICAL_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
ENABLE_EXTERNAL_AI=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@healthcopilot.local
TRUST_PROXY=false
PGSSL=false
UPLOAD_MAX_MB=12
# 32 random bytes encoded as base64url or 64-character hex. Keep stable or stored records cannot be decrypted.
DOCUMENT_ENCRYPTION_KEY=
